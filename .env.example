DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=12345
DB_NAME=postgresql

# Required for embeddings — get a key at platform.openai.com
OPENAI_API_KEY=sk-abcdef1234567890abcdef1234567890abcdef12

# Set to "true" to enable Whisper transcription fallback (slow on CPU, ~1-3 min/video)
WHISPER_ENABLED=false

# Phase 2 — Telegram (not needed for Phase 1)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
